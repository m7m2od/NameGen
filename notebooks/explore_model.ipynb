    "\n",
    "print(f\"\\n🎯 Data shapes:\")\n",
    "print(f\"Training: X={X_train.shape}, Y={Y_train.shape}\")\n",
    "print(f\"Validation: X={X_val.shape}, Y={Y_val.shape}\")\n",
    "print(f\"Test: X={X_test.shape}, Y={Y_test.shape}\")"
