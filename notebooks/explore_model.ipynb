   "source": [
    "## 🔍 Step 7: Model Analysis & Interpretation\n",
    "\n",
    "Let's dive deeper into what our model learned by examining its internal representations."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze the embedding layer\n",
    "print(\"🔍 Analyzing character embeddings...\")\n",
    "\n",
    "# Get embeddings\n",
    "embedding_layer = model.model.layers[0]\n",
    "embeddings = embedding_layer.weight.data\n",
    "\n",
    "print(f\"Embedding shape: {embeddings.shape}\")\n",
    "print(f\"Characters: {list(mappings['itos'].values())}\")\n",
    "\n",
    "# Compute pairwise similarities\n",
    "import torch.nn.functional as F\n",
    "normalized_emb = F.normalize(embeddings, p=2, dim=1)\n",
    "similarity_matrix = normalized_emb @ normalized_emb.T\n",
    "\n",
    "# Visualize similarity matrix\n",
    "plt.figure(figsize=(12, 10))\n",
    "plt.imshow(similarity_matrix.numpy(), cmap='coolwarm', vmin=-1, vmax=1)\n",
    "plt.colorbar(label='Cosine Similarity')\n",
    "plt.title('Character Embedding Similarity Matrix')\n",
    "\n",
    "# Add character labels\n",
    "char_labels = [mappings['itos'][i] for i in range(len(mappings['itos']))]\n",
    "plt.xticks(range(len(char_labels)), char_labels)\n",
    "plt.yticks(range(len(char_labels)), char_labels)\n",
    "plt.xlabel('Character')\n",
    "plt.ylabel('Character')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Find most similar character pairs\n",
    "print(\"\\n🔗 Most similar character pairs:\")\n",
    "similarity_pairs = []\n",
    "for i in range(len(char_labels)):\n",
    "    for j in range(i+1, len(char_labels)):\n",
    "        sim = similarity_matrix[i, j].item()\n",
    "        similarity_pairs.append((char_labels[i], char_labels[j], sim))\n",
    "\n",
    "similarity_pairs.sort(key=lambda x: x[2], reverse=True)\n",
